<?xml version="1.0"?>
<sdf version="1.8">
  <world name="task4_smoke">
    <physics name="fixed_step" type="ignored">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin name="ignition::gazebo::systems::Physics" filename="ignition-gazebo-physics-system"/>
    <plugin name="ignition::gazebo::systems::UserCommands" filename="ignition-gazebo-user-commands-system"/>
    <plugin name="ignition::gazebo::systems::SceneBroadcaster" filename="ignition-gazebo-scene-broadcaster-system"/>
    <plugin name="ignition::gazebo::systems::Contact" filename="ignition-gazebo-contact-system"/>
    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.75 0.8 0.86 1</background>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <direction>-0.4 0.2 -1</direction>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <cast_shadows>true</cast_shadows>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="plane">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><diffuse>0.63 0.66 0.69 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="check_wall">
      <static>true</static>
      <pose>2.5 0 0.6 0 0 0</pose>
      <link name="wall">
        <collision name="collision">
          <geometry><box><size>0.14 4 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.14 4 1.2</size></box></geometry>
          <material>
            <ambient>0.11 0.50 0.44 1</ambient>
            <diffuse>0.11 0.50 0.44 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
